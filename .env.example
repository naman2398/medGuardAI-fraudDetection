# MedGuardAI Configuration

# CMS API Settings
CMS_API_URL=https://data.cms.gov/data-api/v1/dataset/92396110-2aed-4d63-a6a2-5d6207d46a29/data
CMS_CHUNK_SIZE=1000

# LEIE API Settings
LEIE_URL=https://oig.hhs.gov/exclusions/downloadables/UPDATED.csv

# Local Storage
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# GCS Settings (Update with your values)
GCS_BUCKET=medguard-ai-data
GCS_RAW_PREFIX=raw
GCS_PROCESSED_PREFIX=processed

# Upload Settings
UPLOAD_TO_GCS=false

# BigQuery Settings
BQ_PROJECT_ID=your-project-id
BQ_DATASET=medguard_ai
BQ_TABLE=claims_features

# PySpark Settings
SPARK_EXECUTOR_MEMORY=4g
SPARK_DRIVER_MEMORY=2g

# ML Pipeline Configuration
# MLflow Configuration (optional - for remote tracking)
# MLFLOW_TRACKING_URI=http://your-mlflow-server:5000
# MLFLOW_TRACKING_USERNAME=your-username
# MLFLOW_TRACKING_PASSWORD=your-password

# Data Configuration for Training
# N_ROWS_SAMPLE=100000  # Uncomment to use a sample for testing
